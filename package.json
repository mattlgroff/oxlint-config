{
  "name": "@mattlgroff/oxlint-config",
  "version": "0.1.0",
  "description": "Matt's personal Oxlint recommendations for starting a new TypeScript project.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattlgroff/oxlint-config.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    }
  },
  "files": [
    "index.mjs",
    "index.d.mts",
    "rules.json",
    "vendor",
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@oxlint/plugins": "1.83.0",
    "@shadcn/lint": "0.1.0"
  },
  "peerDependencies": {
    "oxlint": "1.83.0"
  },
  "devDependencies": {
    "oxlint": "1.83.0"
  }
}
